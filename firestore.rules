rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Histórico de modelos: só a coleção "modelos" (e seus logotipos) é acessível.
    // Todo o resto do banco continua bloqueado por padrão.
    match /modelos/{modeloId} {
      allow read, delete: if true;

      allow create, update: if request.resource.data.title is string
                            && request.resource.data.title.size() <= 200
                            && request.resource.data.activeMode in [1, 2, 3];

      match /logos/{logoId} {
        allow read, delete: if true;

        allow create, update: if logoId in ['header', 'logo1', 'logo2']
                              && request.resource.data.data is string
                              && request.resource.data.data.size() < 1000000;
      }
    }
  }
}
